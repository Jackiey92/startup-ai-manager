#!/usr/bin/env python3
"""Stable L2 bridge for local MinerU/Docling document ingestion.

The bridge owns the engine-specific conversion and always emits the same L2
manifest.  Engines run locally; this process never sends source bytes or full
text to a remote service.
"""
from __future__ import annotations

import argparse
import hashlib
from html.parser import HTMLParser
import importlib.util
import json
import mimetypes
import os
import zipfile
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


FORMATS = {
    ".pdf": "pdf", ".doc": "doc", ".docx": "docx", ".xls": "xls",
    ".xlsx": "xlsx", ".ppt": "ppt", ".pptx": "pptx",
    ".png": "image", ".jpg": "image", ".jpeg": "image", ".tif": "image",
    ".tiff": "image",
}


def _now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _format(path: Path, task: dict[str, Any]) -> str:
    return str(task.get("format") or FORMATS.get(path.suffix.lower(), "unknown"))


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _engine_available(name: str) -> bool:
    if name == "mineru":
        return importlib.util.find_spec("mineru") is not None or _which("mineru")
    if name == "docling":
        return importlib.util.find_spec("docling") is not None or _which("docling")
    return False


def _which(command: str) -> bool:
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(directory) / command
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return True
    return False


def _select_engine() -> tuple[str, list[str]]:
    requested = os.environ.get("SAM_INGEST_ENGINE", "auto").lower()
    if requested not in {"auto", "mineru", "docling"}:
        raise ValueError("SAM_INGEST_ENGINE must be auto, mineru, or docling")
    if requested != "auto":
        return requested, [] if _engine_available(requested) else [f"{requested} is not installed"]
    for candidate in ("mineru", "docling"):
        if _engine_available(candidate):
            return candidate, []
    return "none", ["neither MinerU nor Docling is installed"]


class _TableParser(HTMLParser):
    """Small stdlib HTML table reader for MinerU's local table output."""

    def __init__(self) -> None:
        super().__init__()
        self.rows: list[list[str]] = []
        self._row: list[str] | None = None
        self._cell: list[str] | None = None

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag == "tr":
            self._row = []
        elif tag == "td" and self._row is not None:
            self._cell = []

    def handle_data(self, data: str) -> None:
        if self._cell is not None:
            self._cell.append(data)

    def handle_endtag(self, tag: str) -> None:
        if tag == "td" and self._row is not None and self._cell is not None:
            self._row.append("".join(self._cell).strip())
            self._cell = None
        elif tag == "tr" and self._row is not None:
            self.rows.append(self._row)
            self._row = None


def _text_parts(content: Any) -> list[str]:
    if isinstance(content, str):
        return [content.strip()] if content.strip() else []
    if not isinstance(content, list):
        return []
    parts: list[str] = []
    for item in content:
        if isinstance(item, dict):
            parts.extend(_text_parts(item.get("content", "")))
    return parts


def _mineru_cache_json(file_hash: str, tier: str | None) -> Path | None:
    home = Path(os.environ.get("MINERU_HOME", "~/.mineru")).expanduser()
    root = home / "doclib" / "parsed" / file_hash[:2] / file_hash
    roots = [root / tier] if tier else list(root.iterdir()) if root.exists() else []
    candidates = sorted((p for r in roots if r.exists() for p in r.glob("*.json")), key=lambda p: p.stat().st_mtime, reverse=True)
    return candidates[0] if candidates else None


def _run_mineru(source: Path, file_hash: str) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    """Run only the local MinerU server and convert its local JSON cache."""
    tier = os.environ.get("SAM_MINERU_TIER", "basic")
    started = time.monotonic()
    with tempfile.TemporaryDirectory(prefix="sam-mineru-") as temp:
        mineru_bin = str(Path(sys.executable).with_name("mineru"))
        command = [mineru_bin, "parse", str(source), "--json", "--force", "--wait", "300", "--output", str(Path(temp) / "parse.json")]
        env = dict(os.environ)
        env["MINERU_REMOTE"] = "0"
        proc = subprocess.run(command, text=True, capture_output=True, env=env, timeout=360)
    if proc.returncode != 0:
        raise RuntimeError(f"local MinerU parse failed: {proc.stderr[-1000:]}")
    response: dict[str, Any] = {}
    try:
        response = json.loads(proc.stdout)
    except json.JSONDecodeError:
        pass
    actual_tier = str(response.get("parse", {}).get("tier") or tier)
    parsed = _mineru_cache_json(file_hash, actual_tier)
    if parsed is None:
        parsed = _mineru_cache_json(file_hash, None)
    if parsed is None:
        raise RuntimeError("MinerU completed but no local structured cache JSON was found")
    payload = json.loads(parsed.read_text(encoding="utf-8"))
    pages: list[dict[str, Any]] = []
    text_count = table_count = row_count = 0
    for page in payload.get("pages", []):
        page_no = int(page.get("page_idx", 0)) + 1
        text_items: list[dict[str, Any]] = []
        tables: list[dict[str, Any]] = []
        for block in page.get("blocks", []):
            block_locator = f"mineru:page/{page_no}/block/{block.get('index', 0)}"
            bbox = block.get("bbox")
            block_type = block.get("type")
            if block_type == "table":
                html = "".join(_text_parts(block.get("content", [])))
                table_parser = _TableParser()
                table_parser.feed(html)
                rows = table_parser.rows
                headers = rows[0] if rows else []
                values = rows[1:] if len(rows) > 1 else []
                tables.append({"headers": headers, "rows": values, "source_loc": {"file_hash": file_hash, "page_no": page_no, "bbox": bbox, "locator": block_locator}})
                table_count += 1
                row_count += len(values)
                continue
            for text in _text_parts(block.get("content", [])):
                text_items.append({"text": text, "source_loc": {"file_hash": file_hash, "page_no": page_no, "bbox": bbox, "locator": block_locator}})
                text_count += 1
        pages.append({"page_no": page_no, "bbox": None, "text_items": text_items, "tables": tables})
    summary = {"status": "parsed", "engine": "mineru", "tier": actual_tier, "text_item_count": text_count, "table_count": table_count, "table_row_count": row_count, "warnings": [], "raw_bytes_external": False, "full_text_external": False, "elapsed_ms": round((time.monotonic() - started) * 1000)}
    return pages, summary


def _docling_bbox(provenance: Any) -> list[float] | None:
    bbox = getattr(provenance, "bbox", None)
    if bbox is None:
        return None
    values = [getattr(bbox, name, None) for name in ("l", "t", "r", "b")]
    if any(value is None for value in values):
        return None
    return [float(value) for value in values]


def _docling_provenance(item: Any, file_hash: str, fallback: str) -> dict[str, Any]:
    provenance = next(iter(getattr(item, "prov", []) or []), None)
    page_no = getattr(provenance, "page_no", None) if provenance else None
    return {
        "file_hash": file_hash,
        "page_no": int(page_no) if page_no is not None else None,
        "slide_no": int(page_no) if page_no is not None else None,
        "bbox": _docling_bbox(provenance),
        "locator": str(getattr(item, "self_ref", None) or fallback),
    }


def _run_docling(source: Path, file_hash: str, fmt: str) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    """Convert a local file with Docling's Python API.

    ``docling-slim`` handles Office files without Torch.  PDF conversion may
    require the optional layout/model stack; that failure is reported plainly
    instead of silently falling back to another engine.
    """
    started = time.monotonic()
    from docling.document_converter import DocumentConverter

    document = DocumentConverter().convert(str(source)).document
    page_map: dict[int, dict[str, Any]] = {}

    def page(page_no: int) -> dict[str, Any]:
        return page_map.setdefault(page_no, {"page_no": page_no, "bbox": None, "text_items": [], "tables": []})

    text_count = 0
    for index, item in enumerate(getattr(document, "texts", []) or []):
        loc = _docling_provenance(item, file_hash, f"docling:text/{index}")
        text = str(getattr(item, "text", "") or "").strip()
        if not text:
            continue
        text_count += 1
        page_no = loc.get("page_no") or 1
        page(page_no)["text_items"].append({"text": text, "source_loc": loc})

    table_count = row_count = 0
    for index, item in enumerate(getattr(document, "tables", []) or []):
        dataframe = item.export_to_dataframe()
        values = dataframe.fillna("").astype(str).values.tolist()
        headers = [str(value) for value in dataframe.columns.tolist()]
        loc = _docling_provenance(item, file_hash, f"docling:table/{index}")
        page_no = loc.get("page_no") or 1
        page(page_no)["tables"].append({"headers": headers, "rows": values, "source_loc": loc})
        table_count += 1
        row_count += len(values)

    summary = {
        "status": "parsed",
        "engine": "docling",
        "tier": None,
        "text_item_count": text_count,
        "table_count": table_count,
        "table_row_count": row_count,
        "warnings": ["Docling provenance is unavailable for some Office text items"] if fmt == "docx" else [],
        "raw_bytes_external": False,
        "full_text_external": False,
        "elapsed_ms": round((time.monotonic() - started) * 1000),
    }
    return [page_map[key] for key in sorted(page_map)], summary


def _image_root() -> Path:
    return Path(os.environ.get("SAM_L2_IMAGE_ROOT", ".sam-isolated/data/l2-images"))


def _store_image(data: bytes, filename: str, file_hash: str, page_no: int | None, bbox: list[float] | None, locator: str, **loc_fields: Any) -> dict[str, Any]:
    image_hash = hashlib.sha256(data).hexdigest()
    suffix = Path(filename).suffix.lower() or ".bin"
    target_dir = _image_root() / file_hash
    target_dir.mkdir(parents=True, exist_ok=True)
    target = target_dir / f"{image_hash[:16]}{suffix}"
    if not target.exists():
        target.write_bytes(data)
    try:
        local_path = target.relative_to(Path.cwd()).as_posix()
    except ValueError:
        local_path = target.as_posix()
    source_loc = {"file_hash": file_hash, "page_no": page_no, "bbox": bbox, "locator": locator}
    source_loc.update({key: value for key, value in loc_fields.items() if value is not None})
    return {
        "image_id": f"{file_hash[:16]}:{image_hash[:16]}",
        "filename": filename,
        "mime": mimetypes.guess_type(filename)[0] or "application/octet-stream",
        "page_no": page_no,
        "bbox": bbox,
        "image_hash": image_hash,
        "local_path": local_path,
        "caption": None,
        "source_loc": source_loc,
    }


def _extract_embedded_images(source: Path, file_hash: str, fmt: str) -> list[dict[str, Any]]:
    """Extract embedded image bytes locally, independently of text parsing."""
    images: list[dict[str, Any]] = []
    if fmt == "pdf":
        try:
            import pymupdf

            document = pymupdf.open(source)
            for page_index, page in enumerate(document):
                for image_index, item in enumerate(page.get_images(full=True)):
                    xref = int(item[0])
                    payload = document.extract_image(xref)
                    if not payload or not payload.get("image"):
                        continue
                    rects = page.get_image_rects(xref)
                    rect = rects[0] if rects else None
                    bbox = [float(rect.x0), float(rect.y0), float(rect.x1), float(rect.y1)] if rect else None
                    ext = str(payload.get("ext") or "bin")
                    images.append(_store_image(payload["image"], f"page-{page_index + 1}-image-{image_index}.{ext}", file_hash, page_index + 1, bbox, f"pdf:page/{page_index + 1}/image/{image_index}"))
            document.close()
        except Exception:
            return images
        return images
    if fmt not in {"docx", "xlsx", "pptx"}:
        return images
    try:
        with zipfile.ZipFile(source) as archive:
            media = [name for name in archive.namelist() if "/media/" in name.lower()]
            mapped: set[str] = set()
            if fmt == "docx" and "word/document.xml" in archive.namelist():
                rel_root = ET.fromstring(archive.read("word/_rels/document.xml.rels"))
                rels = {item.attrib["Id"]: item.attrib["Target"] for item in rel_root}
                document_root = ET.fromstring(archive.read("word/document.xml"))
                embed_name = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}embed"
                paragraph_tag = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}p"
                blip_tag = "{http://schemas.openxmlformats.org/drawingml/2006/main}blip"
                for paragraph_no, paragraph in enumerate(document_root.iter(paragraph_tag)):
                    for blip in paragraph.iter(blip_tag):
                        target = rels.get(blip.attrib.get(embed_name), "")
                        name = str(Path("word") / target).replace("\\", "/")
                        if name not in archive.namelist():
                            name = "word/" + target.lstrip("/")
                        if name not in media:
                            continue
                        mapped.add(name)
                        images.append(_store_image(archive.read(name), Path(name).name, file_hash, None, None, f"docx:paragraph/{paragraph_no}", paragraph=paragraph_no))
            elif fmt == "pptx":
                from pptx import Presentation
                from pptx.enum.shapes import MSO_SHAPE_TYPE
                presentation = Presentation(str(source))
                for slide_no, slide in enumerate(presentation.slides, start=1):
                    for shape in slide.shapes:
                        if shape.shape_type != MSO_SHAPE_TYPE.PICTURE:
                            continue
                        blob = shape.image.blob
                        ext = str(shape.image.ext or "bin")
                        bbox = [float(shape.left), float(shape.top), float(shape.left + shape.width), float(shape.top + shape.height)]
                        images.append(_store_image(blob, f"slide-{slide_no}-shape-{shape.shape_id}.{ext}", file_hash, None, bbox, f"pptx:slide/{slide_no}/shape/{shape.shape_id}", slide_no=slide_no, shape=shape.shape_id))
                mapped.update(media)
            elif fmt == "xlsx":
                from openpyxl import load_workbook
                workbook = load_workbook(source, read_only=False, data_only=False)
                for worksheet in workbook.worksheets:
                    for image_index, image in enumerate(getattr(worksheet, "_images", [])):
                        anchor = getattr(image, "anchor", None)
                        origin = getattr(anchor, "_from", None)
                        target = getattr(anchor, "to", None)
                        if origin is None:
                            continue
                        row, col = int(origin.row), int(origin.col)
                        end_row = int(getattr(target, "row", row)) if target else row
                        end_col = int(getattr(target, "col", col)) if target else col
                        ext = str(getattr(image, "format", None) or "bin")
                        bbox = [float(col), float(row), float(end_col), float(end_row)] if target else None
                        cell = f"{worksheet.title}!R{row + 1}C{col + 1}"
                        images.append(_store_image(image._data(), f"{worksheet.title}-image-{image_index}.{ext}", file_hash, None, bbox, f"xlsx:{cell}", sheet=worksheet.title, cell_range=cell))
                mapped.update(media)
            # Keep any image whose relationship/anchor could not be resolved;
            # the explicit null locator fields are safer than dropping bytes.
            for name in media:
                if name not in mapped:
                    images.append(_store_image(archive.read(name), Path(name).name, file_hash, None, None, f"ooxml:{name}"))
    except (zipfile.BadZipFile, OSError):
        pass
    return images


def _manifest(task: dict[str, Any], source: Path) -> dict[str, Any]:
    engine, warnings = _select_engine()
    file_hash = str(task.get("file_hash") or _sha256(source))
    filename = str(task.get("filename") or source.name)
    fmt = _format(source, task)
    pages: list[dict[str, Any]] = []
    images: list[dict[str, Any]] = _extract_embedded_images(source, file_hash, fmt)
    if engine == "mineru" and not warnings:
        try:
            pages, summary = _run_mineru(source, file_hash)
        except Exception as exc:
            summary = {"status": "parse_failed", "engine": "mineru", "text_item_count": 0, "table_count": 0, "table_row_count": 0, "warnings": [str(exc)], "raw_bytes_external": False, "full_text_external": False}
    elif engine == "docling" and not warnings:
        try:
            pages, summary = _run_docling(source, file_hash, fmt)
        except Exception as exc:
            summary = {"status": "parse_failed", "engine": "docling", "text_item_count": 0, "table_count": 0, "table_row_count": 0, "warnings": [str(exc)], "raw_bytes_external": False, "full_text_external": False}
    else:
        status = "engine_unavailable" if engine == "none" or warnings else "adapter_pending"
        summary = {
        "status": status,
        "engine": engine,
        "text_item_count": 0,
        "table_count": 0,
        "table_row_count": 0,
        "warnings": warnings or [f"{engine} adapter is not enabled in this contract-only bridge"],
        "raw_bytes_external": False,
        "full_text_external": False,
        }
    return {
        "source_id": str(task.get("source_id") or file_hash),
        "filename": filename,
        "format": fmt,
        "mime_type": task.get("mime_type") or mimetypes.guess_type(filename)[0],
        "size_bytes": source.stat().st_size,
        "uploaded_at": str(task.get("uploaded_at") or _now()),
        "file_hash": file_hash,
        "pages": pages,
        "images": images,
        "parse_summary": summary,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("task", type=Path, help="task JSON containing source_path or file_path")
    parser.add_argument("--output", type=Path, help="write manifest JSON here instead of stdout")
    args = parser.parse_args()
    task = json.loads(args.task.read_text(encoding="utf-8"))
    source = Path(task.get("source_path") or task.get("file_path", ""))
    if not source.is_file():
        raise SystemExit(f"source file does not exist: {source}")
    result = _manifest(task, source)
    encoded = json.dumps(result, ensure_ascii=False, indent=2) + "\n"
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(encoded, encoding="utf-8")
    else:
        sys.stdout.write(encoded)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
