{
  "agents": {
    "defaults": {
      "model": { "primary": "token-plan/${SAM_LEADER_MODEL}" },
      "models": {
        "token-plan/${SAM_LEADER_MODEL}": { "params": { "enable_thinking": false } }
      },
      "workspace": "${SAM_HARNESS_ROOT}"
    },
    "entries": {
      "sam-leader": {
        "name": "SAM Leader",
        "workspace": "${SAM_HARNESS_ROOT}",
        "model": { "primary": "token-plan/${SAM_LEADER_MODEL}" },
        "tools": {
          "allow": [
            "sam_memory_read",
            "sam_memory_search",
            "sam_file_get",
            "sam_memory_map",
            "sam_conversation_read",
            "sam_thread_list",
            "sam_thread_open",
            "sam_document_ingest"
          ]
        }
      }
    }
  },
  "gateway": { "mode": "local", "bind": "loopback", "auth": { "mode": "token" } },
  "skills": {
    "load": {
      "extraDirs": ["${SAM_SKILL_ROOT}"],
      "watch": false
    }
  },
  "plugins": {
    "entries": {
      "sam-memory": { "enabled": true }
    }
  },
  "tools": {
    "allow": [
      "sam_memory_read",
      "sam_memory_search",
      "sam_file_get",
      "sam_memory_map",
      "sam_conversation_read",
      "sam_thread_list",
      "sam_thread_open",
      "sam_document_ingest"
    ],
    "toolSearch": {
      "enabled": true,
      "mode": "tools",
      "searchDefaultLimit": 5,
      "maxSearchLimit": 10
    },
    "codeMode": { "enabled": false }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "token-plan": {
        "baseUrl": "${SAM_LEADER_MODEL_BASE_URL}",
        "apiKey": "${SAM_LEADER_MODEL_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "${SAM_LEADER_MODEL}",
            "name": "SAM configured model",
            "contextWindow": 262144,
            "maxTokens": 131072
          }
        ]
      }
    }
  }
}
