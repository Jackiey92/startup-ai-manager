{
  "agents": {
    "defaults": {
      "model": { "primary": "${SAM_GUIDE_MODEL}" },
      "workspace": "<absolute path to harness-openclaw>"
    }
  },
  "gateway": { "mode": "local", "bind": "loopback", "auth": { "mode": "token" } },
  "skills": {
    "load": {
      "extraDirs": ["<absolute path to harness-openclaw>/workspace/skills"],
      "watch": false
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "token-plan": {
        "baseUrl": "${SAM_GUIDE_MODEL_BASE_URL}",
        "apiKey": "${SAM_GUIDE_MODEL_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "${SAM_GUIDE_MODEL}",
            "name": "SAM configured model",
            "contextWindow": 262144,
            "maxTokens": 131072
          }
        ]
      }
    }
  }
}
