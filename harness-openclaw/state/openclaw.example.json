{
  "agents": {
    "defaults": {
      "model": { "primary": "doubao-ark/doubao-seed-2-0-mini-260215" },
      "workspace": "<absolute path to harness-openclaw>"
    }
  },
  "gateway": { "mode": "local", "bind": "loopback", "auth": { "mode": "token" } },
  "skills": {
    "load": {
      "extraDirs": ["<absolute path to harness-openclaw>/workspace/skills"],
      "watch": false
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "doubao-ark": {
        "baseUrl": "https://ark.cn-beijing.volces.com/api/v3",
        "apiKey": "${ARK_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "doubao-seed-2-0-mini-260215",
            "name": "Doubao Seed 2.0 Mini",
            "contextWindow": 262144,
            "maxTokens": 131072
          }
        ]
      }
    }
  }
}