  "catalog": "harness-openclaw/tool-registry/manifest.json",
  "skill_catalog": "harness-openclaw/skill-registry/catalog.json",
  "tool_search": {
    "enabled": true,
    "mode": "tools",
    "code_mode": false,
    "availability": "finalizeAgentToolAvailability",
    "execution_allow": "toolExecutionAllow"
  },
  "handoff": {
    "contract_version": "phase3.v1",
    "stages": {
      "2a_mapping": {
        "producer": "file_processor",
        "path_prefix": "l2_staging/",
        "status": "ready",
        "fields": [
          "artifact_id",
          "source_file_hash",
          "manifest_uri",
          "blocks"
        ]
      },
      "2b_facts": {
        "producers": [
          "finance_analyst",
          "legal_analyst",
          "business_analyst"
        ],
        "path_prefix": "facts_2b/<role>/",
        "requires": "2a_mapping.status=ready",
        "fields": [
          "artifact_id",
          "source_2a_id",
          "role",
          "facts"
        ]
      },
      "leader_summary": {
        "producer": "leader",
        "path_prefix": "runtime_outbox/leader/",
        "requires": "all three 2b_facts.status=ready",
        "fields": [
          "artifact_id",
          "source_2b_ids",
          "summary"
        ]
      }
    },
    "downstream_gate": "missing_or_not_ready_upstream_must_not_start"
  },
  "oral_claims": {
    "source": "user",
    "statuses": [
      "claimed_by_user",
      "unverified",
      "verified"
    ],
    "initial_weight": "unverified_not_equal_to_material_fact",
    "verification_requires": "non_empty_material_evidence_sources",
    "verified_weight": "equal_after_material_verification",
    "fields": [
      "claim_id",
      "entity",
      "metric",
      "value",
      "unit",
      "period",
      "quote",
      "source",
      "status",
      "weight",
      "evidence_sources",
      "created_at",
      "updated_at"
    ]
  },
  "stalled_policy": {
    "default_seconds": 90,
    "slow_tools": {
      "sam_document_ingest": {
        "threshold_seconds": 300,
        "heartbeat_is_progress": true
      }
    },
    "classification": {
      "below_threshold": "not_stalled",
      "heartbeat_after_threshold": "progressing_slow_tool",
      "no_heartbeat_after_threshold": "stalled"
    }
  },
  "tool_search_guidance": "harness-openclaw/config/phase3-tool-search-guidance.md",
  "parse_pool": {
    "default_workers": 4,
    "max_workers": 4,
    "startup_log": "parse workers=N (requested=N, max=N)",
    "session_policy": "independent_openclaw_session_per_document",
    "failure_isolation": "one_job_failure_does_not_cancel_other_jobs"
  }
}
