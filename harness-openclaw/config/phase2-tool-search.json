{
  "phase": "phase2",
  "status": "gray",
  "surface": {
    "enabled": true,
    "mode": "tools",
    "directory_enabled": false,
    "code_enabled": false,
    "controls": ["tool_search", "tool_describe", "tool_call"]
  },
  "native_runtime": {
    "tools": {
      "toolSearch": {"enabled": true, "mode": "tools", "searchDefaultLimit": 5, "maxSearchLimit": 10},
      "codeMode": {"enabled": false}
    },
    "allowlist_injection": "finalizeAgentToolAvailability",
    "execution_allow_source": "toolExecutionAllow"
  },
  "catalog": "harness-openclaw/tool-registry/manifest.json",
  "availability_hooks": {
    "finalizer": "finalizeAgentToolAvailability",
    "execution_allow": "toolExecutionAllow"
  },
  "roles": {
    "file_processor": {
      "enabled": true,
      "toolExecutionAllow": ["sam_conversation_read", "sam_document_ingest", "sam_file_get", "sam_memory_map", "sam_memory_read", "sam_memory_search", "sam_thread_list", "sam_thread_open"],
      "write_zones": ["runtime_outbox", "l2_staging", "ov_resources"]
    },
    "finance_analyst": {"enabled": false, "toolExecutionAllow": []},
    "legal_analyst": {"enabled": false, "toolExecutionAllow": []},
    "business_analyst": {"enabled": false, "toolExecutionAllow": []}
  },
  "legacy_compatibility": {"old_path": "read_only", "new_parse_path": "tool_search", "phase2_scope": "file_processor_only"}
}
