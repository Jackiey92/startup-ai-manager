#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
STATE_DIR="${SAM_OPENVIKING_STATE_DIR:-$PROJECT_DIR/harness-openclaw/state/ov-data}"
CONFIG_FILE="${SAM_OV_CONFIG_FILE:-$STATE_DIR/ov.conf}"
SEMANTIC_CONFIG_FILE="${SAM_OV_SEMANTIC_CONFIG_FILE:-$STATE_DIR/ov.semantic.conf}"
MODEL_CACHE_DIR="${SAM_OV_MODEL_CACHE_DIR:-$PROJECT_DIR/harness-openclaw/state/ov-data/models}"
PID_FILE="$STATE_DIR/server.pid"
LOG_FILE="$STATE_DIR/server.log"
HOST="${SAM_OV_HOST:-127.0.0.1}"
PORT="${SAM_OV_PORT:-1933}"

health() {
  python3 - "$HOST" "$PORT" <<'PY'
import json, sys, urllib.error, urllib.request
url = f"http://{sys.argv[1]}:{sys.argv[2]}/health"
try:
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(url, timeout=2) as response:
        payload = json.load(response)
    if payload.get("status") != "ok" or payload.get("healthy") is not True:
        raise RuntimeError(f"unhealthy OpenViking response: {payload!r}")
    print(json.dumps(payload, ensure_ascii=False))
except Exception as exc:
    print(f"Local OpenViking health check failed at {url}: {exc}", file=sys.stderr)
    raise SystemExit(1)
PY
}

write_config() {
  local config_file="$CONFIG_FILE"
  local semantic="${1:-false}"
  mkdir -p "$STATE_DIR/workspace"
  python3 - "$config_file" "$STATE_DIR/workspace" "$HOST" "$PORT" "$semantic" "$MODEL_CACHE_DIR" <<'PY'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
payload = {"storage": {"workspace": str(pathlib.Path(sys.argv[2]).resolve())},
           "server": {"host": sys.argv[3], "port": int(sys.argv[4])}}
if sys.argv[5] == "true":
    payload["embedding"] = {"dense": {
        "provider": "local",
        "model": "bge-small-zh-v1.5-f16",
        "dimension": 512,
        "cache_dir": str(pathlib.Path(sys.argv[6]).expanduser().resolve()),
    }}
path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
PY
  chmod 600 "$config_file"
}

case "${1:-}" in
  config)
    write_config
    printf 'config=%s\nworkspace=%s/workspace\n' "$CONFIG_FILE" "$STATE_DIR"
    ;;
  semantic-config)
    CONFIG_FILE="$SEMANTIC_CONFIG_FILE"
    write_config true
    printf 'config=%s\nworkspace=%s/workspace\nmodel_cache=%s\n' "$CONFIG_FILE" "$STATE_DIR" "$MODEL_CACHE_DIR"
    ;;
  semantic-start)
    SAM_OV_CONFIG_FILE="$SEMANTIC_CONFIG_FILE" SAM_OV_SEMANTIC=true "$0" start
    ;;
  health)
    health
    ;;
  start)
    write_config "${SAM_OV_SEMANTIC:-false}"
    if health >/dev/null 2>&1; then
      echo "Local OpenViking already healthy at http://$HOST:$PORT"
      exit 0
    fi
    if [[ -s "$PID_FILE" ]] && kill -0 "$(<"$PID_FILE")" 2>/dev/null; then
      echo "OpenViking PID $(<"$PID_FILE") exists but /health is unavailable; inspect $LOG_FILE" >&2
      exit 1
    fi
    SERVER_BIN="${OPENVIKING_SERVER_BIN:-$(command -v openviking-server || true)}"
    if [[ -z "$SERVER_BIN" ]]; then echo "openviking-server not found; install OpenViking first" >&2; exit 127; fi
    # Keep local service child environments credential-free even when the
    # launcher itself inherits credentials for unrelated tools.
    env $(env | awk -F= '/^(OV_APIKEY[^=]*|OV_API_KEY|OPENVIKING_API_KEY|VIKINGBOT_API_KEY|OPENVIKING_TOKEN)=/ {print "-u " $1}') \
      "$SERVER_BIN" --config "$CONFIG_FILE" --host "$HOST" --port "$PORT" >>"$LOG_FILE" 2>&1 &
    server_pid=$!
    printf '%s\n' "$server_pid" >"$PID_FILE"
    for _ in $(seq 1 60); do
      if health >/dev/null 2>&1; then echo "Local OpenViking healthy at http://$HOST:$PORT (pid $server_pid)"; exit 0; fi
      if ! kill -0 "$server_pid" 2>/dev/null; then
        echo "OpenViking exited during startup; inspect $LOG_FILE" >&2
        rm -f "$PID_FILE"
        exit 1
      fi
      sleep 1
    done
    echo "OpenViking startup timed out; inspect $LOG_FILE" >&2
    exit 1
    ;;
  stop)
    if [[ ! -s "$PID_FILE" ]]; then echo "No SAM-managed local OpenViking PID file at $PID_FILE"; exit 0; fi
    server_pid="$(<"$PID_FILE")"
    if ! kill -0 "$server_pid" 2>/dev/null; then rm -f "$PID_FILE"; echo "Stale PID file removed"; exit 0; fi
    # Never signal a process unless its command line identifies the configured server.
    if ! tr '\0' ' ' <"/proc/$server_pid/cmdline" | grep -Fq 'openviking-server'; then
      echo "PID $server_pid is not identifiable as openviking-server; refusing to stop it" >&2
      exit 1
    fi
    kill "$server_pid"
    for _ in $(seq 1 20); do
      if ! kill -0 "$server_pid" 2>/dev/null; then rm -f "$PID_FILE"; echo "Stopped local OpenViking PID $server_pid"; exit 0; fi
      sleep 1
    done
    echo "OpenViking PID $server_pid did not stop within 20s" >&2
    exit 1
    ;;
  *)
    echo "Usage: $0 {config|semantic-config|start|semantic-start|health|stop}" >&2
    exit 2
    ;;
esac
