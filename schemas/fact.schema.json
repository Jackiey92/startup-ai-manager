{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-ai-manager.local/schemas/fact.schema.json",
  "title": "SAM verified 2b fact",
  "type": "object",
  "required": ["fact_id", "company_id", "entity_id", "fact_type", "value", "status", "source_refs", "method", "method_version", "revision", "invariant_checks", "calculation_trace", "created_at", "updated_at"],
  "properties": {
    "fact_id": {"type": "string"}, "company_id": {"type": "string"}, "entity_id": {"type": "string"}, "fact_type": {"type": "string"}, "value": {},
    "unit": {"type": ["string", "null"]}, "currency": {"type": ["string", "null"]}, "period": {"type": ["string", "null"]},
    "valid_from": {"type": ["string", "null"]}, "valid_to": {"type": ["string", "null"]}, "observed_at": {"type": ["string", "null"]},
    "status": {"const": "verified"}, "source_refs": {"type": "array", "minItems": 1}, "derived_from": {"type": "array"},
    "method": {"type": "string"}, "method_version": {"type": "string"}, "supersedes": {"type": ["string", "null"]}, "revision": {"type": "integer"},
    "invariant_checks": {"type": "array"}, "calculation_trace": {"type": "object"}, "created_at": {"type": "string"}, "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
